# Server
PORT=3000
NODE_ENV=development

# CORS: the frontend origin allowed to call the API
CORS_ORIGIN=http://localhost:5173

# Added in later phases:
# DATABASE_URL=postgresql://user:password@localhost:5432/bloodflow
# JWT_SECRET=change-me
# Server

# Database (local dev value shown; production comes from AWS environment config)
DATABASE_URL=postgresql://bloodflow:bloodflow_dev_pw@localhost:5432/bloodflow

# Risk thresholds (units). Optional: defaults shown.
# RISK_LOW_MIN=20
# RISK_MEDIUM_MIN=10
# RISK_HIGH_MIN=5
# MAX_UNITS=500

# Auth (generate a secret with: openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Used only by the seed script to create the demo admin user
ADMIN_NAME=Demo Admin
ADMIN_EMAIL=admin@bloodflow.demo
ADMIN_PASSWORD=
